// Definición de modelos (DSL de referencia). NO se usa Prisma ni PostgreSQL:
// `yarn db:gen` genera lib/db/schema.generated.ts (tipos + metadatos) para la capa MongoDB (lib/db/prisma.ts).
// Cada @unique / @@unique se materializa como índice único en MongoDB; las relaciones definen cascadas en borrado.

enum UserRole {
  OWNER_ADMIN
  RECEPTION
  PROFESSIONAL
}

enum PriceType {
  FIXED
  FROM
  CONSULT
}

enum AppointmentStatus {
  PENDING_APPROVAL
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ScheduleSource {
  MANUAL
  GOOGLE_BUSINESS
  GOOGLE_PLACES
}

enum MediaSourceType {
  UPLOAD
  EXTERNAL_URL
  IMPORTED_URL
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  SUPPRESSED
}

enum CampaignStatus {
  DRAFT
  READY
  SCHEDULED
  SENDING
  COMPLETED
  CANCELLED
  FAILED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
  ANONYMIZED
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  passwordHash   String
  role           UserRole     @default(RECEPTION)
  professionalId String?      @unique
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  active         Boolean      @default(true)
  canExportData  Boolean      @default(false)
  canManageMarketing Boolean  @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sessions       Session[]
  auditEvents    AuditEvent[]
}

model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  userAgent    String?
  ipRedacted   String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SalonSettings {
  id                          String         @id @default("default")
  brandName                   String         @default("ESPACIO Q")
  tagline                     String         @default("Un espacio para cuidar de ti")
  city                        String         @default("Madrid")
  country                     String         @default("España")
  timezone                    String         @default("Europe/Madrid")
  currency                    String         @default("EUR")
  locale                      String         @default("es-ES")
  googleMapsUrl               String         @default("https://www.google.com/maps/place/Espacio+Q/@40.4280874,-3.6965673,2467m/data=!3m1!1e3!4m6!3m5!1s0xd4228618d8af967:0xa4f32211fe6d024d!8m2!3d40.4241269!4d-3.6976262!16s%2Fg%2F1q65y9wd5")
  addressLine                 String?
  postalCode                  String?
  neighborhood                String?
  phone                       String?
  whatsapp                    String?
  contactEmail                String?
  noticeEmail                 String?        // "Email de avisos del salón" (fallback: contactEmail)
  instagramUrl                String?
  facebookUrl                 String?
  tiktokUrl                   String?
  // Datos fiscales/legales del titular (para poblar o verificar documentos legales)
  legalOwnerName              String?
  legalTaxId                  String?
  legalRegistryInfo           String?
  legalRegisteredAddress      String?
  legalDpoEmail               String?
  // Políticas operativas de reserva
  publicBookingEnabled        Boolean        @default(true)
  bookingApprovalMode         String         @default("AUTOMATIC") // AUTOMATIC | MANUAL
  slotIntervalMin             Int            @default(15)
  minAdvanceNoticeMin         Int            @default(120)
  maxBookingHorizonDays       Int            @default(60)
  cancellationFreeHours       Int            @default(24)
  rescheduleFreeHours         Int            @default(24)
  // Estado de horarios y sincronización
  activeScheduleSource        ScheduleSource @default(MANUAL)
  scheduleConfirmed           Boolean        @default(true)
  lastScheduleVerifiedAt      DateTime?
  // Configuración de privacidad y retención
  contactRetentionDays        Int            @default(365)
  exportRetentionHours        Int            @default(24)
  analyticsCookiesEnabled     Boolean        @default(false)
  marketingCookiesEnabled     Boolean        @default(false)
  externalMapEmbedEnabled     Boolean        @default(false)
  setupWizardCompleted        Boolean        @default(false)
  updatedAt                   DateTime       @updatedAt
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]

  @@index([active, sortOrder])
}

model Service {
  id                String                @id @default(cuid())
  categoryId        String
  category          ServiceCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name              String
  slug              String                @unique
  shortDescription  String
  description       String
  durationMin       Int
  bufferBeforeMin   Int                   @default(0)
  bufferAfterMin    Int                   @default(10)
  priceType         PriceType             @default(FIXED)
  priceCents        Int?
  currency          String                @default("EUR")
  featured          Boolean               @default(false)
  active            Boolean               @default(true)
  imageAssetId      String?
  imageAsset        MediaAsset?           @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  seoTitle          String?
  seoDescription    String?
  faqJson           Json?
  sortOrder         Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  professionals     ProfessionalService[]
  appointments      Appointment[]

  @@index([active, featured, sortOrder])
  @@index([categoryId])
}

model Professional {
  id                  String                @id @default(cuid())
  name                String
  slug                String                @unique
  roleTitle           String
  bio                 String?
  specialties         String[]
  photoAssetId        String?
  photoAsset          MediaAsset?           @relation(fields: [photoAssetId], references: [id], onDelete: SetNull)
  active              Boolean               @default(true)
  publicVisible       Boolean               @default(true)
  sortOrder           Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                User?
  services            ProfessionalService[]
  workingSchedules    WorkingSchedule[]
  scheduleExceptions  ScheduleException[]
  appointments        Appointment[]
  occupancies         Occupancy[]

  @@index([active, publicVisible, sortOrder])
}

model ProfessionalService {
  id                   String       @id @default(cuid())
  professionalId       String
  professional         Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId            String
  service              Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customDurationMin    Int?
  customPriceCents     Int?
  active               Boolean      @default(true)

  @@unique([professionalId, serviceId])
  @@index([serviceId])
}

model WorkingSchedule {
  id             String         @id @default(cuid())
  targetType     String         @default("SALON") // SALON | PROFESSIONAL
  professionalId String?
  professional   Professional?  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  dayOfWeek      Int            // 0 = Domingo, 1 = Lunes ... 6 = Sábado
  isOpen         Boolean        @default(true)
  // Array JSON de franjas: [{ "start": "10:00", "end": "14:00" }, { "start": "16:00", "end": "20:00" }]
  intervalsJson  Json
  source         ScheduleSource @default(MANUAL)
  updatedBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([targetType, professionalId, dayOfWeek])
}

model ScheduleException {
  id             String         @id @default(cuid())
  targetType     String         @default("SALON") // SALON | PROFESSIONAL
  professionalId String?
  professional   Professional?  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  dateStr        String         // YYYY-MM-DD en Europe/Madrid
  isClosed       Boolean        @default(true)
  intervalsJson  Json?          // Si isClosed=false, franjas especiales para ese día
  reason         String?
  source         ScheduleSource @default(MANUAL)
  authorized     Boolean        @default(true)
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([targetType, dateStr])
  @@index([professionalId, dateStr])
}

model Client {
  id                     String         @id @default(cuid())
  externalId             String?
  firstName              String
  lastName               String?
  email                  String?
  emailNormalized        String?
  phone                  String?
  phoneNormalized        String?
  tags                   String[]
  internalNotes          String?
  preferredCommunication String         @default("EMAIL")
  marketingConsent       Boolean        @default(false)
  marketingConsentAt     DateTime?
  marketingConsentSource String?
  marketingPolicyVersion String?
  welcomeSentAt          DateTime?      // Bienvenida CLIENT_WELCOME enviada (una sola vez por cliente)
  status                 ClientStatus   @default(ACTIVE)
  anonymizedAt           DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  appointments           Appointment[]
  consentEvents          ConsentEvent[]

  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([status, createdAt])
}

model Appointment {
  id                     String             @id @default(cuid())
  referenceCode          String             @unique
  clientId               String
  client                 Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId              String
  service                Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professionalId         String
  professional           Professional       @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  assignedAnyProfessional Boolean           @default(false)
  status                 AppointmentStatus  @default(CONFIRMED)
  attendanceConfirmedAt  DateTime?
  // Tiempos en UTC y fecha local Europe/Madrid
  dateStrMadrid          String             // YYYY-MM-DD
  startTimeMadrid        String             // HH:mm
  endTimeMadrid          String             // HH:mm
  startAtUtc             DateTime
  endAtUtc               DateTime
  blockStartAtUtc        DateTime           // Incluye bufferBeforeMin
  blockEndAtUtc          DateTime           // Incluye bufferAfterMin
  // Snapshots inmutables del servicio en el momento de reservar
  serviceNameSnapshot    String
  durationMinSnapshot    Int
  bufferBeforeSnapshot   Int                @default(0)
  bufferAfterSnapshot    Int                @default(0)
  priceTypeSnapshot      PriceType
  priceCentsSnapshot     Int?
  currencySnapshot       String             @default("EUR")
  // Datos de contacto de la cita y notas del cliente
  customerName           String
  customerEmail          String?
  customerPhone          String?
  customerNotes          String?
  internalNotes          String?
  // Gestión segura por enlace opaco y control de concurrencia/idempotencia
  manageTokenHash        String             @unique
  manageTokenExpiresAt   DateTime
  manageTokenRevoked     Boolean            @default(false)
  idempotencyKey         String?            @unique
  version                Int                @default(1)
  cancelledAt            DateTime?
  cancellationReason     String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  events                 AppointmentEvent[]
  occupancy              Occupancy?
  resourceReservations   ResourceReservation[]
  conflictAlerts         ScheduleConflictAlert[]

  @@index([professionalId, startAtUtc, endAtUtc])
  @@index([dateStrMadrid, status])
  @@index([clientId])
}

model AppointmentEvent {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  eventType     String
  fromStatus    String?
  toStatus      String?
  actorType     String      // CLIENT | ADMIN | SYSTEM
  actorId       String?
  detailsJson   Json?
  createdAt     DateTime    @default(now())

  @@index([appointmentId, createdAt])
}

model Occupancy {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  reason         String       @default("APPOINTMENT") // APPOINTMENT | MANUAL_BLOCK | ABSENCE | HOLD
  startAtUtc     DateTime
  endAtUtc       DateTime
  active         Boolean      @default(true)
  expiresAtUtc   DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([professionalId, active, startAtUtc, endAtUtc])
}

model ResourceReservation {
  id            String       @id @default(cuid())
  resourceKey   String
  resourceName  String
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  startAtUtc    DateTime
  endAtUtc      DateTime
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@index([resourceKey, active, startAtUtc, endAtUtc])
}

model MediaAsset {
  id              String          @id @default(cuid())
  internalName    String
  src             String
  sourceType      MediaSourceType @default(EXTERNAL_URL)
  mimeType        String          @default("image/jpeg")
  width           Int             @default(1200)
  height          Int             @default(1500)
  sizeBytes       Int             @default(0)
  altText         String
  caption         String?
  category        String          @default("general") // hero | salon | servicios | equipo | galeria | newsletter | og
  focalPointX     Float           @default(50)
  focalPointY     Float           @default(50)
  sortOrder       Int             @default(0)
  authorCredit    String?
  licenseNote     String?
  isProvisional   Boolean         @default(false)
  publicVisible   Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  usages          MediaUsage[]
  services        Service[]
  professionals   Professional[]

  @@index([category, publicVisible, sortOrder])
}

model MediaUsage {
  id           String     @id @default(cuid())
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  locationKey  String     // ej. hero.slide.1, newsletter.cover, home.intro, gallery
  locationName String
  createdAt    DateTime   @default(now())

  @@unique([mediaAssetId, locationKey])
  @@index([locationKey])
}

model PageContent {
  id              String            @id @default(cuid())
  key             String            @unique
  title           String
  category        String            @default("PAGE") // PAGE | SECTION | LEGAL |GLOBAL
  slug            String?
  draftData       Json
  publishedData   Json
  hasUnpublished  Boolean           @default(false)
  isPublished     Boolean           @default(true)
  version         Int               @default(1)
  seoTitle        String?
  seoDescription  String?
  updatedBy       String?
  publishedAt     DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  revisions       ContentRevision[]

  @@index([category, isPublished])
}

model ContentRevision {
  id            String      @id @default(cuid())
  pageContentId String
  pageContent   PageContent @relation(fields: [pageContentId], references: [id], onDelete: Cascade)
  version       Int
  snapshotData  Json
  changeNote    String?
  createdBy     String?
  createdAt     DateTime    @default(now())

  @@index([pageContentId, version])
}

model Subscriber {
  id                   String              @id @default(cuid())
  email                String
  emailNormalized      String              @unique
  firstName            String?
  tags                 String[]
  status               SubscriberStatus    @default(PENDING)
  verifyTokenHash      String?             @unique
  verifyTokenExpiresAt DateTime?
  unsubscribeTokenHash String              @unique
  confirmedAt          DateTime?
  unsubscribedAt       DateTime?
  policyVersion        String              @default("v1.0")
  source               String              @default("newsletter_dialog")
  welcomeSentAt        DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  consentEvents        ConsentEvent[]
  campaignRecipients   CampaignRecipient[]

  @@index([status, createdAt])
}

model ConsentEvent {
  id            String      @id @default(cuid())
  subscriberId  String?
  subscriber    Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  email         String
  action        String      // OPT_IN_REQUESTED | DOUBLE_OPT_IN_CONFIRMED | UNSUBSCRIBED | PREFERENCES_UPDATED | ADMIN_REVOKED
  channel       String      // newsletter_dialog | footer_form | booking_form | unsubscribe_link | admin
  policyVersion String
  consentText   String
  createdAt     DateTime    @default(now())

  @@index([email, createdAt])
}

model Suppression {
  id              String   @id @default(cuid())
  emailNormalized String   @unique
  reason          String   // UNSUBSCRIBED | HARD_BOUNCE | COMPLAINT | MANUAL_SUPPRESSION
  sourceEventId   String?
  createdAt       DateTime @default(now())
}

model Campaign {
  id                String              @id @default(cuid())
  name              String
  subject           String
  preheader         String?
  heading           String
  bodyText          String
  ctaLabel          String?
  ctaUrl            String?
  heroImageUrl      String?
  segmentFilterJson Json                // { tags?: string[], onlyConfirmed?: boolean }
  status            CampaignStatus      @default(DRAFT)
  scheduledAtUtc    DateTime?
  sentAtUtc         DateTime?
  totalRecipients   Int                 @default(0)
  acceptedCount     Int                 @default(0)
  deliveredCount    Int                 @default(0)
  bouncedCount      Int                 @default(0)
  complainedCount   Int                 @default(0)
  unsubscribedCount Int                 @default(0)
  createdBy         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  recipients        CampaignRecipient[]

  @@index([status, scheduledAtUtc])
}

model CampaignRecipient {
  id                String     @id @default(cuid())
  campaignId        String
  campaign          Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriberId      String
  subscriber        Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  emailNormalized   String
  status            String     @default("PENDING") // PENDING | ACCEPTED | DELIVERED | BOUNCED | SUPPRESSED_SKIPPED | FAILED
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  errorText         String?

  @@unique([campaignId, subscriberId])
  @@index([campaignId, status])
}

model EmailTemplate {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  category     String   @default("TRANSACTIONAL") // TRANSACTIONAL | MARKETING
  subject      String
  preheader    String?
  heading      String
  bodyTemplate String
  ctaLabel     String?
  footerNote   String?
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model AutomationRule {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  triggerEvent    String
  templateKey     String
  offsetMinutes   Int      @default(0) // Ej. -1440 para 24h antes, -120 para 2h antes
  active          Boolean  @default(true)
  description     String?
  updatedAt       DateTime @updatedAt
}

model OutboxEvent {
  id          String    @id @default(cuid())
  eventType   String
  AggregateId String
  payloadJson Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([processedAt, createdAt])
}

model NotificationJob {
  id             String    @id @default(cuid())
  jobType        String    // SEND_TRANSACTIONAL_EMAIL | APPOINTMENT_REMINDER | SEND_CAMPAIGN_BATCH
  dedupKey       String    @unique
  appointmentId  String?
  appointmentVer Int?
  payloadJson    Json
  status         JobStatus @default(PENDING)
  scheduledAtUtc DateTime  @default(now())
  attempts       Int       @default(0)
  maxAttempts    Int       @default(4)
  nextAttemptUtc DateTime  @default(now())
  lockedUntilUtc DateTime?
  lastError      String?
  completedAtUtc DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledAtUtc, nextAttemptUtc])
  @@index([appointmentId])
}

model EmailDelivery {
  id                String    @id @default(cuid())
  dedupKey          String    @unique
  category          String    // TRANSACTIONAL | MARKETING
  templateKey       String
  toEmail           String
  subject           String
  htmlBody          String
  textBody          String
  status            String    @default("QUEUED") // QUEUED | ACCEPTED | DELIVERED | BOUNCED | COMPLAINED | FAILED | SIMULATED_LOCAL
  providerName      String    @default("RESEND")
  providerMessageId String?   @unique
  appointmentId     String?
  campaignId        String?
  errorMessage      String?
  acceptedAt        DateTime?
  deliveredAt       DateTime?
  bouncedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([toEmail, createdAt])
  @@index([status, createdAt])
}

model ImportJob {
  id             String            @id @default(cuid())
  fileName       String
  mode           String            @default("CREATE_ONLY") // CREATE_ONLY | UPSERT_BY_EMAIL
  totalRows      Int               @default(0)
  createdCount   Int               @default(0)
  updatedCount   Int               @default(0)
  skippedCount   Int               @default(0)
  errorCount     Int               @default(0)
  status         String            @default("COMPLETED")
  actorUserId    String?
  createdAt      DateTime          @default(now())
  rowResults     ImportRowResult[]
}

model ImportRowResult {
  id          String    @id @default(cuid())
  importJobId String
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber   Int
  action      String    // CREATED | UPDATED | SKIPPED | ERROR
  message     String
  email       String?

  @@index([importJobId, rowNumber])
}

model ExportJob {
  id             String   @id @default(cuid())
  scope          String
  columnsJson    Json
  rowCount       Int
  downloadToken  String   @unique
  expiresAtUtc   DateTime
  actorUserId    String?
  createdAt      DateTime @default(now())
}

model IntegrationConnection {
  id                    String    @id @default(cuid())
  provider              String    @unique // GOOGLE_BUSINESS | GOOGLE_PLACES | EMAIL_RESEND
  status                String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED | ERROR | PENDING_CREDENTIALS
  accountLabel          String?
  externalLocationId    String?
  externalLocationTitle String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  lastSyncAt            DateTime?
  lastSyncStatus        String?
  lastError             String?
  configJson            Json?
  updatedAt             DateTime  @updatedAt
}

model SyncEvent {
  id          String   @id @default(cuid())
  provider    String
  status      String   // SUCCESS | ERROR | CONFLICT_DETECTED
  summary     String
  detailsJson Json?
  createdAt   DateTime @default(now())

  @@index([provider, createdAt])
}

model ScheduleConflictAlert {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  reason        String
  source        String
  resolved      Boolean     @default(false)
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([resolved, createdAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, createdAt])
  @@index([actorUserId, createdAt])
}

model ContactMessage {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String?
  message     String
  status      String    @default("NEW") // NEW | IN_PROGRESS | RESOLVED | ARCHIVED
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
}

// Rate limiting persistente (válido con varias instancias). La clave contiene un hash, nunca la IP en claro.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
