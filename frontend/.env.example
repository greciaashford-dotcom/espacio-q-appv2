# URL pública canónica de la aplicación
APP_URL=http://localhost:3000

# Base de datos PostgreSQL 16+ (requiere extensión btree_gist)
DATABASE_URL=

# Secretos de seguridad (generar con: openssl rand -hex 32)
# IMPORTANTE: usar claves distintas para AUTH_SECRET, CRON_SECRET y TOKEN_ENCRYPTION_KEY
AUTH_SECRET=
CRON_SECRET=
TOKEN_ENCRYPTION_KEY=

# Email (Adaptador Resend o compatible)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="ESPACIO Q <no-reply@espacioq.es>"
EMAIL_REPLY_TO=
EMAIL_WEBHOOK_SECRET=

# Google Business Profile API (OAuth 2.0 - Fuente preferida de horarios)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_BUSINESS_LOCATION_ID=

# Google Places API (Alternativa oficial de lectura de horarios)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Almacenamiento de objetos compatible con S3/R2 (opcional en desarrollo local)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Dominios HTTPS externos permitidos para importación/referencia de imágenes (separados por comas)
ALLOWED_IMAGE_DOMAINS="images.unsplash.com,plus.unsplash.com"
